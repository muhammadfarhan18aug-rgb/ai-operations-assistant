DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_operations
JWT_SECRET=change_this_in_development
JWT_EXPIRE_MINUTES=60
SEED_PASSWORD=change_me_for_local_demo
# Optional compatibility for older local setups:
# SEED_ADMIN_PASSWORD=change_me_for_local_demo
# SEED_ALI_PASSWORD=change_me_for_local_demo
# SEED_SARA_PASSWORD=change_me_for_local_demo
# SEED_DAVE_PASSWORD=change_me_for_local_demo
# Leave MODEL_API_KEY empty to use the deterministic development fallback.
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
# Optional when MODEL_PROVIDER=openai-compatible.
MODEL_BASE_URL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
