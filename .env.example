# Application
APP_NAME=AI Operations Assistant
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_operations_assistant

# Auth (placeholders for future use)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# LLM / model provider (placeholders for future use)
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=

# Embeddings (placeholders for future use)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
